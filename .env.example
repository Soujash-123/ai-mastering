# Copy this file to .env and set your values before running docker-compose.
#
# NOTE: this root .env is only used by docker-compose for ${VAR} substitution
# and to build the frontend image. The backend container reads backend/.env
# (see the backend service's env_file), which is where Appwrite credentials must
# live. Do not duplicate the Appwrite key here.
GROQ_API_KEY=your_groq_api_key_here
NEXT_PUBLIC_API_BASE=http://localhost:8000
