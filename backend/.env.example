GROQ_API_KEY=your_groq_api_key_here
# Model for mastering reasoning (openai/gpt-oss-20b recommended)
GPT_OSS_MASTERING_MODEL=openai/gpt-oss-20b

DATABASE_URL=sqlite:///./data/kord_auth.db
JWT_SECRET_KEY=change-me-use-a-long-random-secret-in-production

# Paths
AI_MASTERING_DATA_DIR=./data

# Appwrite Cloud Storage (server-side secret; never exposed to the frontend).
# This is the single source of truth: the backend container reads this file
# directly via docker-compose `env_file`. Set all four for mastered-audio cloud
# storage to activate; leave them blank to run without it.
#
# The project must be active in the Appwrite console. A project paused for
# inactivity returns 403 `project_paused` and every master will report
# appwrite_state="failed" until it is restored.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=

# How long a master stays in Appwrite before it is deleted. When the window
# closes the local master and its exports are purged too, so cloud and local
# retention expire together.
APPWRITE_TTL_HOURS=12
# Also delete the user's original upload on expiry. Off by default: the
# retention window is about the finished master, not their source audio.
APPWRITE_PURGE_LOCAL_INPUT=false
